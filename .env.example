# URL base da Pumangol Marketplace API (sem barra no fim).
# Produção: https://portal.pumangol.co.ao/api/book-store
# Local: http://localhost:8000 · Docker: http://localhost:8080
# O nome antigo api_url continua a ser aceite. Sem URL, o build falha de propósito.
VITE_API_URL=http://localhost:8000

# Funcionalidades novas da API já publicadas pelo backend, separadas por vírgulas.
# Valores: campaigns, checkout-options, order-tracking, order-fields, backoffice-theme
# A API de produção já tem as quatro primeiras. backoffice-theme (cores do back-office para toda a equipa)
# liga-se depois de publicar a API com GET/PUT /settings/theme. Ver docs/api-campos-em-falta.md. Vazio = nenhuma.
api_features=campaigns,checkout-options,order-tracking,order-fields
